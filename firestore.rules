rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hard-deny: Admin SDK API routes only ─────────────────────────────
    // APIs: /api/card/activate, /api/cards, /api/emergency, /api/admin,
    //       /api/profile/*, /api/doctor/patient, /api/scan
    match /cards/{cardId} {
      allow read, write: if false;
    }

    match /profiles/{profileId} {
      allow read, write: if false;
    }

    match /scans/{scanId} {
      allow read, write: if false;
    }

    match /rate_limits/{id} {
      allow read, write: if false;
    }

    match /accessLogs/{id} {
      allow read, write: if false;
    }

    match /stickerOrders/{orderId} {
      allow read, write: if false;
    }

    // ── Legacy dashboard (PIN + custom token) ────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /notifications/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /notifications/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Doctor visit notes — create via client or Admin; no public reads
    match /doctor_scans/{scanId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Order form writes — create only; no client reads of others' orders
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Deny anything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
