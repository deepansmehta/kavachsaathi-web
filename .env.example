# KavachSaathi — copy to .env.local and fill real values
# NEVER commit .env.local

# Firebase Client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Site URLs
# Production: https://your-domain.com  |  Local: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp order CTA (country code + number, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Coming-soon / launch gate (ISO 8601 with IST offset)
# Default in code: 2026-10-11T12:00:00+05:30 (11 Oct 2026, 12:00 PM IST)
# Override only for local testing, then remove / restore.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-11T12:00:00+05:30

# Firebase Admin (server only — keep secret)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Optional: full service account JSON as a single string
FIREBASE_SERVICE_ACCOUNT_KEY=

# Forgot-PIN email (nodemailer → Gmail)
# Sender is gdmtechnoworld@gmail.com; use a Google App Password
GMAIL_APP_PASSWORD=

# Optional — Razorpay (without these, order API stays demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
