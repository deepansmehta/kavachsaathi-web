# KavachSaathi — copy to .env.local (never commit secrets)
# Fill every required value before Netlify production deploy.

# ─── Firebase Client (public / browser) ───────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kavachsaathi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Site URLs (production: https://kavachsaathi.in) ───────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Marketing / launch ───────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Countdown UI only — site unlock uses ACTIVATION_OPENS_AT (same default):
NEXT_PUBLIC_LAUNCH_DATE=2026-10-11T12:00:00+05:30
# Emergency override for marketing/pre-launch middleware (leave unset normally):
# SITE_PRELAUNCH_FORCE=open
# SITE_PRELAUNCH_FORCE=closed

# ─── Firebase Admin (server only — pick ONE credential style) ─────────────
# Style A: split fields
FIREBASE_ADMIN_PROJECT_ID=kavachsaathi
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Style B: full service-account JSON string (alternative to A)
FIREBASE_SERVICE_ACCOUNT_KEY=
# Local-only alternative: place service-account.json in project root

# ─── Admin panel (/admin) Google allowlist ────────────────────────────────
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=

# ─── My Profile session HMAC (required in production) ─────────────────────
PROFILE_SESSION_SECRET=

# ─── Profile PII encryption (AES-256-GCM, 32-byte key as base64) ───────────
# openssl rand -base64 32
PROFILE_ENC_KEY=

# ─── Activation schedule (no redeploy on launch day) ───────────────────────
# Real kits open when server UTC time >= ACTIVATION_OPENS_AT AND
# ACTIVATION_ENABLED is not an explicit kill switch (false/0/off/no).
# Demo (KVS-DEMO-*) and disposable (KVS-2099-*) always remain activatable.
ACTIVATION_OPENS_AT=2026-10-11T12:00:00+05:30
# Emergency kill switch only — leave unset (or true) for scheduled open:
# ACTIVATION_ENABLED=false

# ─── DPDP grievance officer (required when ACTIVATION_OPENS_AT is set) ─────
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=

# Non-production test clock / force-real IDs (ignored when NODE_ENV=production)
# ACTIVATION_TEST_NOW=2026-10-11T11:00:00+05:30
# ACTIVATION_TEST_AS_REAL=KVS-2099-TREAL

# Pre-launch QA bypass (production Netlify only — min 16 chars).
# ?preview=<value> sets httpOnly cookie for 2h. No effect after ACTIVATION_OPENS_AT.
# PRELAUNCH_PREVIEW_SECRET=

# ─── Smoke / E2E may read the same var locally when CONTEXT=production ───

# ─── Pending upload cleanup (Netlify scheduled function) ──────────────────
# CLEANUP_DRY_RUN=true
# CLEANUP_MAX_AGE_MS=86400000

# ─── Firebase Storage (same project; set after bucket exists) ─────────────
FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# ─── Optional integrations ────────────────────────────────────────────────
GMAIL_APP_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Smoke test only (scripts/smoke-test.ts) ──────────────────────────────
# SMOKE_BASE_URL=http://localhost:3000
